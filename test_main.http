###

# Antecipação com sucesso: HTTP 200 / BD
POST http://127.0.0.1:8000/v1/emprestimos/antecipar-parcela
Content-Type: application/json
Accept: application/json

{
  "codigoSolicitante": 0,
  "numeroContrato": "50017",
  "listaCompetencias": ["202501"]
}

###

# Antecipação com erro: HTTP 412 / UC
POST http://127.0.0.1:8000/v1/emprestimos/antecipar-parcela
Content-Type: application/json
Accept: application/json

{
  "codigoSolicitante": 0,
  "numeroContrato": "6420",
  "listaCompetencias": ["052024", "062024", "072024"]
}

###

# Exclusão: 136 = 200/BF; 124 ou 130 = 200 com nulos;
# 125 ou 129 = 412/TA; 134 ou 137 = 412/HY; 142 ou 132 = 412/HZ.
# 133 = 404 com code/error/message; 135 = 500 com erros/codigo/mensagem.
# Consulte MOCK_EXCLUSAO.md para a lista completa e os corpos de resposta.
PUT http://127.0.0.1:8000/v1/emprestimos/excluir-consignado-trabalhador
Content-Type: application/json
Accept: application/json

{
  "numeroInscricaoEmpregador": "12345678000199",
  "cpfTrabalhador": 12345678901,
  "matricula": "MOCK",
  "motivoExclusao": 1,
  "numeroContrato": "136"
}

